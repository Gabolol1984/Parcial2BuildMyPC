# ============================================================
# BuildMyPC Backend - Variables de entorno
# ============================================================
# Copia este archivo a .env y rellena tus valores reales.
# NUNCA subas el archivo .env a GitHub.
# ============================================================

# Clave secreta JWT (mínimo 32 caracteres aleatorios)
# Genera una con: openssl rand -base64 32
JWT_SECRET=CAMBIA_ESTO_POR_UNA_CLAVE_ALEATORIA_DE_32_CARACTERES

# Base de datos H2 (local / desarrollo)
DB_USERNAME=sa
DB_PASSWORD=

# Base de datos PostgreSQL (Supabase / Producción en Render)
# Nota: La URL debe empezar con jdbc:postgresql://
DATABASE_URL=jdbc:postgresql://db.TU_PROYECTO.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=TU_PASSWORD_DE_SUPABASE
